{
  "name": "clocktower",
  "private": true,
  "scripts": {
    "start": "turbo start --filter=@clocktower/server & turbo start --filter=@clocktower/player & { sleep 4 && turbo start --filter=@clocktower/storyteller; }",
    "start:server": "turbo start --filter=@clocktower/server",
    "start:storyteller": "turbo start --filter=@clocktower/storyteller",
    "start:player": "turbo start --filter=@clocktower/player",
    "dev": "turbo dev --filter=@clocktower/server & turbo dev --filter=@clocktower/player & { sleep 4 && turbo dev --filter=@clocktower/storyteller; }",
    "dev:server": "turbo dev --filter=@clocktower/server",
    "dev:storyteller": "turbo dev --filter=@clocktower/storyteller",
    "dev:player": "turbo dev --filter=@clocktower/player",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=@clocktower/server",
    "test:all": "turbo test test:e2e"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "react-native-worklets": "0.5.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "turbo": "^2.8.17"
  }
}
